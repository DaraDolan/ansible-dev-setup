# ---------------------------------------------------------------------------
# MANAGED BY ANSIBLE - roles/zsh/files/zshrc
#
# This file is copied over ~/.zshrc on every playbook run. Local edits are
# destroyed. Change it in the repo and re-run:
#     ansible-playbook playbook.yml --tags zsh -K
#
# roles/zsh is the sole owner of this file. Do not add lineinfile tasks that
# append to ~/.zshrc from other roles - they run before this copy and are
# silently discarded.
# ---------------------------------------------------------------------------

# --- PATH (early: starship/mise/zoxide inits below need these dirs) --------
# ~/.local/bin must come first: it holds the pinned Neovim tarball symlink,
# uv, mise, lazygit and starship, and it must win over any older system copy.
export PATH="$HOME/.local/bin:$HOME/.config/composer/vendor/bin:$PATH"

# Snap binaries, if this machine has snapd at all. Appended rather than
# prepended so a leftover snap never shadows ~/.local/bin.
[[ -d /snap/bin ]] && export PATH="$PATH:/snap/bin"

# --- History (oh-my-zsh used to configure this) ----------------------------
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt share_history          # one history across all open shells
setopt inc_append_history     # write entries as they run, not on exit
setopt extended_history       # keep timestamps
setopt hist_ignore_dups       # skip immediate duplicates
setopt hist_ignore_space      # ' cmd' stays out of history

# --- Filesystem navigation (oh-my-zsh used to provide these) ---------------
setopt auto_cd                # type a directory name to cd into it
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

# eza (installed by the playbook) for the listing shortcuts. `ls` itself is
# deliberately NOT aliased: eza's flags differ (`ls -lt` is an error in eza,
# where -t takes a timestamp name), so plain ls keeps working as expected.
if command -v eza &> /dev/null; then
    # long list, hidden files, column headers, git status per file, dirs first
    alias l='eza -la --header --git --group-directories-first --icons=auto'
    # tree view, two levels, skipping anything .gitignore'd
    alias lt='eza --tree --level=2 --git-ignore --group-directories-first --icons=auto'
else
    alias l='ls -lah'
fi

# `take <dir>`: mkdir -p then cd into it in one shot
take() {
    mkdir -p "$1" && cd "$1"
}

# Custom completion scripts (e.g. glow), must be in fpath before compinit
# runs (compinit happens at the end of ~/.zinitrc)
fpath=(~/.zsh/completions $fpath)

# --- Plugins: zinit only, oh-my-zsh removed --------------------------------
source "$HOME/.zinitrc"

# --- Prompt: Starship (replaces powerlevel10k) -----------------------------
command -v starship &> /dev/null && eval "$(starship init zsh)"

# Add custom local configuration sourcing if desired
[[ -d ~/.dotfiles/zsh/local ]] && for file in ~/.dotfiles/zsh/local/*.zsh; do
  source "$file"
done

# Set Neovim as default editor
export EDITOR="nvim"
export VISUAL="nvim"

# Initialize mise for Node.js version management
if command -v mise &> /dev/null; then
    eval "$(mise activate zsh)"
fi

# Initialize zoxide for fast directory jumping (z <dir>, zi for interactive)
if command -v zoxide &> /dev/null; then
    eval "$(zoxide init zsh)"
fi

# fzf keybindings: Ctrl-R history, Ctrl-T files, Alt-C cd into subdirectory.
# `--zsh` needs fzf >= 0.48, so probe before sourcing (an older system fzf
# may still be lying around; the playbook installs a pinned current one).
# See docs/cli-tools-guide.md for the workflow guide.
if command -v fzf &> /dev/null && fzf --zsh &> /dev/null; then
    source <(fzf --zsh)
    # Find files with fd: respects .gitignore, so Ctrl-T never drowns you
    # in node_modules/ or vendor/; --hidden still shows dotfiles.
    export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
    # Preview the highlighted file with bat in the Ctrl-T picker
    export FZF_CTRL_T_OPTS="--preview 'bat --color=always --style=numbers --line-range=:200 {}'"
    # Nord colours for every fzf picker (Ctrl-R/Ctrl-T/Alt-C, zi). bg:-1 keeps
    # the terminal's own background.
    export FZF_DEFAULT_OPTS="--color=fg:#d8dee9,bg:-1,hl:#88c0d0,fg+:#eceff4,bg+:#3b4252,hl+:#8fbcbb \
--color=info:#ebcb8b,prompt:#81a1c1,pointer:#88c0d0,marker:#a3be8c,spinner:#b48ead,header:#5e81ac,border:#4c566a"
fi

# --- Nord colours for the remaining tools ----------------------------------
# Matches the starship prompt, tmux, Neovim and the Windows Terminal scheme.
# Autosuggestion ghost text: Nord's comment colour (as nord-vim uses). The
# default (ANSI 8 = #4c566a under Nord) is barely visible on #2e3440.
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#616e88'
# bat (and the fzf preview above, which runs bat) uses its built-in Nord theme
export BAT_THEME="Nord"

# Explicitly disable Claude Code telemetry - remove any existing telemetry variables
unset CLAUDE_CODE_ENABLE_TELEMETRY
unset OTEL_METRICS_EXPORTER
unset OTEL_EXPORTER_DISABLED
export CLAUDE_CODE_ENABLE_TELEMETRY=0
export OTEL_EXPORTER_DISABLED=1

# Token for the Claude Code GitHub plugin (sent as the MCP server's Bearer
# header). A dedicated token in ~/.config/claude/github-token wins; otherwise
# reuse the gh CLI login. Re-read in every shell so a rotated token, or a
# tmux server started before login, never leaves a stale value behind.
() {
  local token_file="$HOME/.config/claude/github-token" token
  if [[ -r "$token_file" ]]; then
    token="$(<"$token_file")"
  elif (( $+commands[gh] )); then
    token="$(gh auth token 2>/dev/null)"
  fi
  if [[ -n "$token" ]]; then
    export GITHUB_PERSONAL_ACCESS_TOKEN="$token"
  else
    unset GITHUB_PERSONAL_ACCESS_TOKEN
  fi
}

# Claude Code alias
alias ccode='claude code'
# General productivity aliases
alias c="clear"
alias sizes='du -sh -c *'
alias os='cd ~/code/php/open-source'

# `o` (open file manager here) and `cwd` (copy pwd to clipboard) were
# macOS-only (`open`, `pbcopy`); pick the right tool per platform.
if grep -qi microsoft /proc/version 2>/dev/null; then
  alias o="explorer.exe ."
  alias cwd="pwd && pwd | tr -d '\n' | clip.exe && echo 'Copied to clipboard 📁'"
  # (N) is zsh's null-glob qualifier. Without it an unmatched pattern is a
  # hard "no matches found" error rather than an empty expansion, and zsh
  # raises it before `ls` ever runs, so redirecting stderr does not help.
  ollama_win=(/mnt/c/Users/*/AppData/Local/Programs/Ollama/ollama.exe(N))
  if (( ${#ollama_win} )); then
    alias ollama="${ollama_win[1]}"
  fi
  unset ollama_win
elif [[ "$OSTYPE" == darwin* ]]; then
  alias o="open ."
  alias cwd="pwd && pwd | tr -d '\n' | pbcopy && echo 'Copied to clipboard 📁'"
else
  alias o="xdg-open ."
  command -v xclip &> /dev/null && alias cwd="pwd && pwd | tr -d '\n' | xclip -selection clipboard && echo 'Copied to clipboard 📁'"
fi

# Laravel development aliases and functions (deployed by roles/laravel)
[[ -f ~/.laravel-aliases.sh ]] && source ~/.laravel-aliases.sh

# Composer shortcuts
alias co='composer'
alias ci='co install'
alias cg='nvim ~/.composer/composer.json'
alias cogu='co global update'
alias ptest='./vendor/bin/pest'

# Laravel Sail shortcuts (official Laravel recommendation)
alias sail='sh $([ -f sail ] && echo sail || echo vendor/bin/sail)'
alias spf='sail test --filter'

# Custom functions
sz() {
    zinit cclear    # Clear zinit's cache
    source ~/.zshrc
    echo 'Sourced zshrc and cleared zinit cache'
}

v() {
    nvim .
}
